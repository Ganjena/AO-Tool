<%- layout("layout/boilerplate") %>
    <div class="container">
        <div class="row justify-content-around">
            <div class="col-8 my-3">
                <h3>Enemy Defense Power</h3>
                <h7><i>If there are no figures here, update the enemy buildings page</i></h7>
                    <table class="table table-hover table-striped mt-2">
                        <thead class="tableHead">
                            <tr>
                                <th scope="col">Type</th>
                                <th scope="col">Min Attack Power</th>
                                <th scope="col">Max Attack Power</th>
                                <th scope="col">Likley Attack Power</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">VS Sea:</th>
                                <td colspan="">
                                    <%=attackStats.againstSea.minAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstSea.maxAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstSea.likleyAmount%>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">VS Air:</th>
                                <td colspan="">
                                    <%=attackStats.againstAir.minAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstAir.maxAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstAir.likleyAmount%>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">VS Vehicals:</th>
                                <td colspan="">
                                    <%=attackStats.againstVeh.minAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstVeh.maxAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstVeh.likleyAmount%>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">VS Infantry:</th>
                                <td colspan="">
                                    <%=attackStats.againstInf.minAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstInf.maxAmount%>
                                </td>
                                <td colspan="">
                                    <%=attackStats.againstInf.likleyAmount%>
                                </td>
                            </tr>
                        </tbody>
                    </table>
            </div>
            <div class="col-8">
                <h3>Your Attack Power</h3>
                <h7><i>(Your attack power vs different unit types. AP from UBK/BK are added to all unit types)</i></h5>
                    <table class="table table-hover table-striped mt-2">
                        <thead class="tableHead">
                            <tr>
                                <th scope="col">Type</th>
                                <th scope="col">Attack Power</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">VS Sea:</th>
                                <td colspan="">
                                    <%=build.attackStats.againstSea%>
                                </td>                              
                            </tr>
                            <tr>
                                <th scope="row">VS Air:</th>
                                <td colspan="">
                                    <%=build.attackStats.againstAir%>
                                </td>                              
                            </tr>
                            <tr>
                                <th scope="row">VS Vehicals:</th>
                                <td colspan="">
                                    <%=build.attackStats.againstVeh%>
                                </td>                              
                            </tr>
                            <tr>
                                <th scope="row">VS Infantry:</th>
                                <td colspan="">
                                    <%=build.attackStats.againstInf%>
                                </td>                               
                            </tr>
                        </tbody>
                    </table>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-8 my-3 text-center">
                <h3 class="text-center">Win/Loss</h3>
                <h7 class=""><i>(Win/Loss is based on enemies likley AP+10% vs your AP)</i></h7>
                <div class="card mx-auto" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title"><%= winLoss.condition %></h5>
                        <p class="card-text"><%= winLoss.info%></p>
                    </div>
                </div>
            </div>
        </div>
    </div>