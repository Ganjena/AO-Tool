<%- layout("layout/boilerplate") %> 
<div class="container h-100">
    <div class="row justify-content-around h-100">
        <h2>Insert Building and Land Reports</h2>
        <div class="col-8">
            <table class="table table-hover">
                <thead>
                    <tr class="">
                        <th scope="col">Name</th>
                        <th scope="col" colspan="">Low Amount</th>
                        <th scope="col">High Amount</th>

                    </tr>
                </thead>
                <form action="/air_units" method="POST">
                <tbody>
                    <% for (let key of Object.keys(buildings)){ %> 
                        <tr>
                            <th scope="row"><%=buildings[key].name %></th>
                            <td><input type="text" name="<%=key%>[amount]"></td>
                            <td><input type="text" name="<%=key%>[amount]"></td>
                        </tr>
                        <% } %> 
                        <th> Land</th>
                        <td><input type="text"></td>
                </tbody>
              </table>
              <div class="d-grid">
                <button type="submit" class="btn btn-secondary">Add Units</button>
            </div>
        </form>
        </div>