<%- layout("layout/boilerplate") %> 
<div class="container h-100">
    <div class="row justify-content-around h-100">
        <div class="col-10">
            <table class="table table-hover table-striped">
                <thead>
                    <tr class="tableHead">
                        <th scope="col">Name</th>
                        <th scope="col" colspan="2">Price</th>
                        <th scope="col">Attack</th>
                        <th scope="col">Targets</th> 
                        <th scope="col">Owned</th> 
                        <th scope="col">Build</th> 
                    </tr>
                </thead>
                <form action="/missiles" method="POST">
                <tbody>
                    <% for (let key of Object.keys(missiles)){ %> 
                        <tr>
                            <th scope="row"><%=missiles[key].name %></th>
                            <td colspan="2"><%=`$${missiles[key].price}`%></td>
                            <td colspan=""><%=missiles[key].attack%></td>
                            <td colspan=""><%=missiles[key].targets%></td>
                            <td colspan=""><%=missiles[key].amount%></td>
                            <td><input type="text" name="<%=key%>[amount]"></td>
                        </tr>
                        <% } %> 
                </tbody>
              </table>
              <div class="d-grid">
                <button type="submit" class="btn btn-secondary">Add Units</button>
            </div>
        </form>
        </div>
    </div>
</div>