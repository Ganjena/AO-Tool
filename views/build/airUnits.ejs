<%- layout("layout/boilerplate") %> 
<div class="container">
    <div class="row justify-content-around">
        <div class="col-10">
            <table class="table table-striped table-hover">
                <thead>
                    <tr class="tableHead">
                        <th scope="col">Name</th>
                        <th scope="col" colspan="2">Price</th>
                        <th scope="col">Att/Life</th>
                        <th scope="col">Targets</th> 
                        <th scope="col">Owned</th> 
                        <th scope="col">Build</th> 
                    </tr>
                </thead>
                <form action="/air_units" method="POST">
                <tbody>
                    <% for (let key of Object.keys(airUnits)){ %> 
                        <tr>
                            <th scope="row"><%=airUnits[key].name %></th>
                            <td colspan="2"><%=`$${airUnits[key].price}`%></td>
                            <td colspan=""><%=`${airUnits[key].attack}/${airUnits[key].defense}`%></td>
                            <td colspan=""><%=airUnits[key].targets%></td>
                            <td colspan=""><%=airUnits[key].amount%></td>
                            <td><input class="unitInput" type="text" name="<%=key%>[amount]"></td>
                        </tr>
                        <% } %> 
                </tbody>
            </table>
            <div class="d-grid">
                <button type="submit" class="btn btn-secondary">Add Units</button>
            </div>
        </form>
        </div>
    </div>
</div>