<%- layout("layout/boilerplate") %> 
<div class="container h-100">
    <div class="row justify-content-around h-100">
        <div class="col-10">
            <table class="table table-hover table-striped">
                <thead>
                    <tr class="tableHead">
                        <th scope="col">Name</th>
                        <th scope="col" colspan="2">Effect</th>
                        <th scope="col">Price</th>
                        <th scope="col">Select</th>
                    </tr>
                </thead>
                <form action="/satellite" method="POST">
                <tbody>
                    <% for (let key of Object.keys(satellite)){ %>
                        <tr class="">
                            <td colspan="2" class="for-checklabel" for="<%=key%>"><%=satellite[key].effect%></td>
                            <th scope="row" class="for-checklabel" for="<%=key%>"><%=satellite[key].name%></th>
                            <td colspan="" class="for-checklabel" for="<%=key%>"><%=`$${satellite[key].price}`%></td>
                            <td><input class="form-check-input" id="<%=key%>" type="radio" name="selected" value="<%=key%>" <%if(satellite[key].amount === 1) {%> checked <%};%>></td>
                        </tr>
                        <% } %> 
                </tbody>
              </table>
              <div class="d-grid">
                <button type="submit" class="btn btn-secondary">Add Satellite</button>
            </div>
        </form>
    </div>
</div>
