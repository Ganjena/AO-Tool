<%- layout("layout/boilerplate") %> 
<div class="container h-100">
    <div class="row justify-content-around h-100">
        <div class="col-8">
            <table class="table table-hover">
                <thead>
                    <tr class="">
                        <th scope="col">Name</th>
                        <th scope="col" colspan="2">Price</th>
                        <th scope="col">Att/Life</th>
                        <th scope="col">Targets</th> 
                        <th scope="col">Owned</th> 
                        <th scope="col">Build</th> 
                    </tr>
                </thead>
                <form action="/buildings" method="POST">
                <tbody>
                    <%for (let key of Object.keys(buildings)){%>
                        <tr>
                            <th scope="row"><%= buildings[key].name %></th>
                            <td colspan="2"><%=`$${buildings[key].price}`%></td>
                            <td colspan=""><%=`${buildings[key].attack}/${buildings[key].defense}`%></td>
                            <td colspan=""><%=buildings[key].targets%></td>
                            <td colspan=""><%=buildings[key].amount%></td>
                            <td><input type="text" name="<%=key%>[amount]"></td>
                        </tr>
                    <%}%>
                </tbody>
              </table>
            <div class="d-grid">
                <button type="submit" class="btn btn-secondary">Add Buildings</button>
            </div>
        </form>
        </div>
    </div>
</div>