<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet">
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"> -->
    <link rel="stylesheet" href="custom.css">
    <link rel="stylesheet" href="main.css">

    <title>Assault.Online Tool</title>
</head>

<body>
    <div class="container border rounded-3 shadow my-5 p-0  mainBackground">
        <div class="text-center p-3 m-0 h-50" id="banner">
            <h1 class="h-100 w-100 m-0 pb-5 text-white">Assault.Online Tool</h1>
        </div>
        <div class="row justify-content-around text-center text-white border-top-0 m-0 " id="navBar">
            <div class="col-2">
                <% if(typeof totalNW!==`undefined`){ %>
                    Networth: $ <%=totalNW%>
                        <%}%>
            </div>
            <div class="col-2">
                Turns Used: 123
            </div>
            <div class="col-2">
                <% if(typeof land!==`undefined`){ %>
                    Land: <%=land%>m3
                        <%}%>
            </div>
            <div class="col-2">
                <% if(typeof power!==`undefined`){ %>
                    Power: <%=power%>%
                        <%}%>
            </div>
        </div>
        <div class="row m-3">
            <div class="col-2 pt-3 px-3">
                <div id="">
                    <h4>Calculators</h4>
                    <ul>
                        <li><a href="/enemy" class="link-secondary">Enemy Setup</a></li>
                        <li><a href="/attack" class="link-secondary">Attack Calculator</a></li>
                        <li><a href="/power" class="link-secondary">Power/land Calculator</a></li>
                        <li><a href="/stats" class="link-secondary">Stats</a></li>
                    </ul>
                </div>
                <div id="">
                    <h4>Build Menu</h4>
                    <ul>
                        <li><a href="/home" class="link-secondary">Home</a></li>
                        <li><a href="/research" class="link-secondary">Research</a></li>
                        <li><a href="/land" class="link-secondary">Land</a></li>
                        <li><a href="/buildings" class="link-secondary">Buildings</a></li>
                        <li><a href="/sea_units" class="link-secondary">Sea Units</a></li>
                        <li><a href="/air_units" class="link-secondary">Air Units</a></li>
                        <li><a href="/vehicle_units" class="link-secondary">Vehicle Units</a></li>
                        <li><a href="/infantry_units" class="link-secondary">Infantry Units</a></li>
                        <li><a href="/missiles" class="link-secondary">Missiles</a></li>
                        <li><a href="/satellite" class="link-secondary">Satellite</a></li>
                        <li><a href="/account" class="link-secondary">Account</a></li>
                        <li><a href="/logout" class="link-secondary">Logout</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-10 my-3   h-100 d-inline-block ">
                <%- include("./flash")%>
                    <%- body %>
            </div>
        </div>
        <div class="mt-5">
            <div class="text-center ">
                <p><strong>Assault.Online Tool</strong> </p>
                <p class="text-muted">Created by Ganjena</p>

            </div>
        </div>
    </div>
    <script src="bootstrap.bundle.min.js"></script>

</body>

</html>