<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Assault.Online Tool</title>
</head>

<body>
    <div class="container">
        <div class="text-center">
            <h1>Assault.Online Tool</h1>
            <hr>
        </div>
        <div class="row justify-content-around text-center">
            <div class="col-2">
                Networth: $<%=totalNW%>
            </div>
            <div class="col-2">
                Turns Used: 123
            </div>
            <div class="col-2">
                Land: <%=land%> m2
            </div>
            <div class="col-2">
                Power: <%=power%>%
            </div>
        </div>
        <hr>
        <div class="row mb-5">
            <div class="col-2">
                <div id="">
                    <h4>Calculators</h4>
                    <ul>
                        <li><a href="/enemy">Enemy Setup</a></li>
                        <li><a href="/attack">Attack Calculator</a></li>
                        <li><a href="/power">Power/land Calculator</a></li>
                        <li><a href="/stats">Stats</a></li>
                    </ul>
                </div>
                <div id="">
                    <h4>Build Menu</h4>
                    <ul>
                        <li><a href="/research">Research</a></li>
                        <li><a href="/land">Land</a></li>
                        <li><a href="/buildings">Buildings</a></li>
                        <li><a href="/sea_units">Sea Units</a></li>
                        <li><a href="/air_units">Air Units</a></li>
                        <li><a href="/vehicle_units">Vehicle Units</a></li>
                        <li><a href="/infantry_units">Infantry Units</a></li>
                        <li><a href="/missiles">Missiles</a></li>
                        <li><a href="/satellite">Satellite</a></li>
                        <li><a href="/reset">Reset</a></li>
                        <li><a href="/logout">Logout</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-10 mb-5 h-100 d-inline-block">
                <%- include("./flash")%>
                    <%- body %>
            </div>
        </div>
        <div class="fixed-bottom mt-5">
            <div class="text-center ">
                <p><strong>Assault.Online Tool</strong> </p>
                <p class="text-muted">Created by Ganjena</p>

            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
</body>

</html>