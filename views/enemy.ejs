<%- layout("layout/boilerplate") %> 
<div class="container">
    <div class="row">
        <div class="col-12">
            <h4>Copy/Paste Spy Report:</h4>
            <form action="/enemy" method="POST">
                <textarea name="report" id="report" cols="30" rows="10" placeholder="copy and paste a full spy report here..."></textarea>
                <button class="submit">Submit</button>
            </form>
        </div>
        <div class="col-12">
            <h4>Current Report:</h4>
            <ul>
                <li>Name:</li>
                <li>Current Networth:</li>
                <li>Current Land: <%= enemyLand %> m3</li>
            </ul>
            <ul>
                <li>Units:</li>
                <ul>
                <%    for (let unitType of Object.keys(units)){ %>
                <%        for (let unit of Object.keys(units[unitType])){ %>
                <%            if (units[unitType][unit].minAmount > 0){ %>
                               <li> <%=`${units[unitType][unit].name} ${units[unitType][unit].minAmount} - ${units[unitType][unit].maxAmount}`%></li>
                <%            }	%>
                <%        } %>
                <%    } %>
                </ul>
            </ul>
            <ul>
                <li>Buildings:</li>
                <ul>
                <% 	for (let key of Object.keys(buildings)){ %>
                    <% if (buildings[key].minAmount > 0){ %>
                        <li><%=`${buildings[key].name} ${buildings[key].minAmount} - ${buildings[key].maxAmount}` %></li>
                   <% }%>
                <%  } %>
                </ul>
            </ul>
        </div>
    </div>
</div>