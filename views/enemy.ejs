<%- layout("layout/boilerplate") %> 
<div class="container">
    <div class="row">
        <div class="col-12">
            <h4>Copy/Paste Spy Report:</h4>
            <form action="/enemy" method="POST">
                <textarea name="report" id="report" cols="30" rows="10" placeholder="copy and paste a full spy report here..."></textarea>
                <button class="submit">Submit</button>
            </form>
        </div>
        <div class="col-12">
            <h4>Current Report:</h4>
            <ul>
                <li>Name:</li>
                <li>Current Networth:</li>
                <li>Reported Networth:</li>
                <li>Current Land:</li>
                <li>Reported Land:</li>
            </ul>
            <ul>
                <li>Units:</li>
                <ul>
                    <li>units name - amount</li>
                    <li>units name - amount</li>
                    <li>units name - amount</li>
                    <li>units name - amount</li>
                </ul>
            </ul>
            <ul>
                <li>Buildings:</li>
                <ul>
                    <li>Building name - amount</li>
                    <li>Building name - amount</li>
                    <li>Building name - amount</li>
                    <li>Building name - amount</li>
                </ul>
            </ul>
        </div>
    </div>
</div>